# Copy this file to ".env" (same folder) and fill in real values.
# ".env" holds secrets -- never share it or commit it to any repo.

# Gmail account the report is sent FROM. Can be the same as EMAIL_RECIPIENT
# (i.e. the account emails itself) or a different Gmail account.
EMAIL_SENDER=youraddress@gmail.com

# App Password for EMAIL_SENDER (NOT your normal Gmail password).
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
# It's a 16-character code like: abcd efgh ijkl mnop  (remove spaces when pasting)
EMAIL_APP_PASSWORD=your16charapppassword

# Address the daily report is sent TO.
EMAIL_RECIPIENT=nexora11.data@gmail.com

# Optional: set this to enable Claude-written rationales instead of the
# built-in template. Get a key at https://console.anthropic.com/
# If left blank, the agent still works fine using template text.
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown):
MAX_WORKERS=8
PICKS_PER_CATEGORY=3
MIN_SCORE=40
