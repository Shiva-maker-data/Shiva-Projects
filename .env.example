# Copy this file to ".env" (same folder) and fill in real values.
# ".env" holds secrets -- never share it or commit it to any repo.

# Gmail account the report is sent FROM. Can be the same as EMAIL_RECIPIENT
# (i.e. the account emails itself) or a different Gmail account.
EMAIL_SENDER=youraddress@gmail.com

# App Password for EMAIL_SENDER (NOT your normal Gmail password).
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
# It's a 16-character code like: abcd efgh ijkl mnop  (remove spaces when pasting)
EMAIL_APP_PASSWORD=your16charapppassword

# Address(es) the daily report is sent TO. Comma-separate for more than one:
# EMAIL_RECIPIENT=nexora11.data@gmail.com, someoneelse@gmail.com
EMAIL_RECIPIENT=nexora11.data@gmail.com

# Optional: set this to enable Claude-written rationales instead of the
# built-in template. Get a key at https://console.anthropic.com/
# If left blank, the agent still works fine using template text.
ANTHROPIC_API_KEY=

# Optional: export daily suggestions + resolved outcomes to a Google Sheet
# for accuracy tracking. Leave both blank to skip this entirely. See
# README.md "Google Sheets export" for the one-time Google Cloud setup.
# GOOGLE_SHEET_ID is the long ID in the sheet's URL between /d/ and /edit.
# GOOGLE_SERVICE_ACCOUNT_JSON is the ENTIRE content of the service account
# JSON key file, pasted as one line.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional tuning (defaults shown):
MAX_WORKERS=8
PICKS_PER_CATEGORY=3
MIN_SCORE=40

# Optional: position-sizing assumptions used to compute suggested share
# quantity per pick (see position_sizing.py). ACCOUNT_CAPITAL is illustrative
# only -- set it to your real trading capital in INR for sizing to be useful.
ACCOUNT_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
